# =============================================================================
# RAMAZANOĞLU TECH MAIL HQ - CLOUD BACKEND ENVIRONMENT TEMPLATE (.env.example)
# Copy to .env (never commit it) and fill in real values.
# The server REFUSES TO START if SUPER_ADMIN_PASSWORD / JWT_SECRET are missing or weak.
# Generate a secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# =============================================================================

PORT=8765
# 127.0.0.1 = only reachable through a local reverse proxy / tunnel (recommended)
HOST=127.0.0.1
NODE_ENV=production
# Number of reverse-proxy hops in front of the app (1 for Cloudflare Tunnel / nginx / Caddy), else 0
TRUST_PROXY=0
# Extra browser origins allowed for CORS (comma separated). Same-origin PWA needs none.
ALLOWED_ORIGINS=

# Database (required unless MOCK_MODE=true). Neon/Supabase URLs need ?sslmode=require
DATABASE_URL=
# Set to false ONLY for a plain local/docker Postgres without TLS
DATABASE_SSL=true

# First OWNER account, created automatically on first start. SUPER_ADMIN_PASSWORD is its initial
# password (min 16 chars); the owner must change it at first login. Later users are created in the
# admin panel (/admin.html) with a one-time temporary password.
OWNER_EMAIL=yusuf@ramazanoglu.tech
OWNER_NAME=Yusuf Ramazanoğlu
SUPER_ADMIN_PASSWORD=
# Legacy shared X-Super-Admin-Key for the Qt desktop client. Set to false once it uses accounts.
LEGACY_API_KEY_ENABLED=true
# JWT signing secret (min 32 chars)
JWT_SECRET=
# Session lifetime of the login token
JWT_EXPIRES_IN=12h

# Strict Domain Filter
DOMAIN_FILTER=@ramazanoglu.tech

# 7/24 Cloud IMAP Synchronization Listener (Gmail TLS) - use a NEW Google app password
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_TLS=true
IMAP_USER=
IMAP_PASSWORD=
IMAP_POLL_INTERVAL_MS=30000
IMAP_AUTO_RECONNECT=true

# Outbound SMTP Mail Dispatcher (Gmail SSL)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# docker-compose only
POSTGRES_USER=mailhq
POSTGRES_PASSWORD=
POSTGRES_DB=ramazanoglu_mail_db

# Throw-away demo with fake data and /api/dev/simulate. NEVER true in production.
MOCK_MODE=false

# --- docker-compose only ---
# Cloudflare Tunnel token (docker compose --profile tunnel up -d)
CLOUDFLARE_TUNNEL_TOKEN=
TRUST_PROXY=1

# --- Gmail-free inbound mail (Cloudflare Email Routing -> Worker -> /api/inbound/email) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Same value must be set on the Worker:  npx wrangler secret put INBOUND_WEBHOOK_SECRET
INBOUND_WEBHOOK_SECRET=

# --- Company tools (docker compose --profile tools) ---
# Vaultwarden admin page token (empty = disabled). Use a long random value: openssl rand -base64 48
VAULTWARDEN_ADMIN_TOKEN=
# true only while creating the first accounts, then false
VAULTWARDEN_SIGNUPS_ALLOWED=true
