# =============================================================================
# RAMAZANOĞLU TECH MAIL HQ - CLOUD BACKEND ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and provide your production credentials.
# =============================================================================

PORT=8765
HOST=0.0.0.0
NODE_ENV=production

# Database (Leave empty for In-Memory fallback, or enter your PostgreSQL URL)
DATABASE_URL=

# Super Admin Access Key & JWT Authentication
SUPER_ADMIN_PASSWORD=SetYourStrongSuperAdminPasswordHere!
JWT_SECRET=your-32-chars-minimum-super-admin-jwt-secret-key
JWT_EXPIRES_IN=30d

# Strict Domain Filter
DOMAIN_FILTER=@ramazanoglu.tech

# 7/24 Cloud IMAP Synchronization Listener (Gmail TLS)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_TLS=true
IMAP_USER=your_corporate_inbox@gmail.com
IMAP_PASSWORD=your_google_app_password
IMAP_POLL_INTERVAL_MS=30000
IMAP_AUTO_RECONNECT=true

# Outbound SMTP Mail Dispatcher (Gmail SSL)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_corporate_inbox@gmail.com
SMTP_PASSWORD=your_google_app_password

# Live Production Mode
MOCK_MODE=false
