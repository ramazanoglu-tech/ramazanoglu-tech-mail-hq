/* =============================================================================
   RAMAZANOĞLU TECH MAIL HQ - SWISS-STYLE ARCHITECTURAL MINIMALISM STYLESHEET
   100% Zero-Border-Radius, Pure Architectural Grid, High-Contrast Typography
   ============================================================================= */

* {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    border-radius: 0px !important;
    outline: none;
}

QWidget {
    background-color: #FBFBF9;
    color: #111111;
    selection-background-color: #111111;
    selection-color: #FFFFFF;
}

QMainWindow, QDialog {
    background-color: #FBFBF9;
}

/* ARCHITECTURAL GRID BORDERS & PANELS */
QFrame, QWidget#leftColumn {
    background-color: #F3F3EE;
    border: none;
}

QWidget#middleColumn {
    background-color: #FBFBF9;
    border-right: 1px solid #E2E2DC;
}

QWidget#rightColumn {
    background-color: #FBFBF9;
}

/* TYPOGRAPHY & LABELS */
QLabel {
    color: #111111;
    font-size: 13px;
}

QLabel[heading="true"] {
    font-family: 'Inter', sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: #111111;
    letter-spacing: -0.02em;
}

QLabel[mono="true"] {
    font-family: 'JetBrains Mono', 'Consolas', monospace;
    font-size: 11px;
    color: #666662;
}

/* INPUT CONTROLS */
QLineEdit {
    background-color: #FFFFFF;
    color: #111111;
    border: 1px solid #E2E2DC;
    padding: 8px 10px;
    font-size: 12px;
    border-radius: 0px;
}

QLineEdit:focus {
    border: 1px solid #111111;
}

QTextEdit, QTextBrowser {
    background-color: #FFFFFF;
    color: #111111;
    border: 1px solid #E2E2DC;
    padding: 10px;
    font-size: 13px;
    border-radius: 0px;
}

QTextEdit:focus {
    border: 1px solid #111111;
}

/* COMBO BOX (SMART IDENTITY SELECTOR) */
QComboBox {
    background-color: #FFFFFF;
    color: #111111;
    border: 1px solid #E2E2DC;
    padding: 6px 10px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    border-radius: 0px;
}

QComboBox:focus, QComboBox:on {
    border: 1px solid #111111;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #E2E2DC;
    background-color: #F3F3EE;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #111111;
    selection-background-color: #111111;
    selection-color: #FFFFFF;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    padding: 4px;
}

/* BUTTONS */
QPushButton {
    background-color: #FFFFFF;
    color: #111111;
    border: 1px solid #E2E2DC;
    padding: 8px 14px;
    font-size: 12px;
    font-weight: 500;
    border-radius: 0px;
}

QPushButton:hover {
    background-color: #F3F3EE;
    border-color: #111111;
}

QPushButton:pressed {
    background-color: #111111;
    color: #FFFFFF;
}

QPushButton[primary="true"] {
    background-color: #111111;
    color: #FFFFFF;
    border: 1px solid #111111;
    font-weight: 700;
    font-family: 'JetBrains Mono', monospace;
}

QPushButton[primary="true"]:hover {
    background-color: #333330;
    border-color: #333330;
}

/* LIST WIDGETS */
QListWidget {
    background-color: #FFFFFF;
    border: 1px solid #E2E2DC;
    border-radius: 0px;
}

QListWidget::item {
    border-bottom: 1px solid #E2E2DC;
    padding: 4px;
    border-radius: 0px;
}

QListWidget::item:hover {
    background-color: #FBFBF9;
}

QListWidget::item:selected {
    background-color: #F3F3EE;
    color: #111111;
}

/* SCROLL BARS */
QScrollBar:vertical {
    border: none;
    background: #F3F3EE;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #D2D2CC;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #111111;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: #F3F3EE;
    height: 8px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #D2D2CC;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: #111111;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* SYSTEM TRAY MENU */
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #111111;
    padding: 4px;
    border-radius: 0px;
}

QMenu::item {
    padding: 6px 20px;
    font-size: 12px;
    color: #111111;
}

QMenu::item:selected {
    background-color: #111111;
    color: #FFFFFF;
}

QMenu::separator {
    height: 1px;
    background-color: #E2E2DC;
    margin: 4px 0px;
}
